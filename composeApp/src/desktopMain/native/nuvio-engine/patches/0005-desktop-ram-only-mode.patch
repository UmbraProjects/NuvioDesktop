+void RamStorageRegistry::remove_torrent_by_id(const std::string& torrent_id) {
+    std::lock_guard lock(mutex_);
+    const auto found = by_id_.find(torrent_id);
+    if (found == by_id_.end()) {
+        return;
+    }
+    if (found->second) {
+        for (const auto& [piece, data] : found->second->pieces) {
+            static_cast<void>(piece);
+            if (data) {
+                used_bytes_ -= std::min<std::uint64_t>(used_bytes_, data->size());
+            }
+            if (piece_count_ > 0) {
+                --piece_count_;
+            }
+        }
+        found->second->pieces.clear();
+    }
+    by_id_.erase(found);
+}
