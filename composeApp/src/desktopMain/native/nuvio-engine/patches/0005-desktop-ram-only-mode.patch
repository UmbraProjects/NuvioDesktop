+int RamStorageRegistry::TorrentStorage::piece_size(const lt::piece_index_t piece) const {
+    if (files.total_size() <= 0 || files.piece_length() <= 0) {
+        return 0;
+    }
+    const auto num_pieces = static_cast<int>(
+        (files.total_size() + files.piece_length() - 1) / files.piece_length()
+    );
+    const auto index = static_cast<int>(piece);
+    if (index < 0 || index >= num_pieces) {
+        return 0;
+    }
+    return index < num_pieces - 1
+        ? files.piece_length()
+        : static_cast<int>(
+              files.total_size() -
+              static_cast<std::int64_t>(num_pieces - 1) * files.piece_length()
+          );
+}
