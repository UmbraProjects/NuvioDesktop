+std::string normalize_hex(std::string value) {
+    std::ranges::transform(value, value.begin(), [](const unsigned char character) {
+        return static_cast<char>(std::tolower(character));
+    });
+    return value;
+}
+
+bool is_hex_id(const std::string& value) {
+    if (value.size() != 40 && value.size() != 64) {
+        return false;
+    }
+    return std::ranges::all_of(value, [](const unsigned char character) {
+        return std::isxdigit(character) != 0;
+    });
+}
+
+std::string derive_torrent_id(const lt::storage_params& params) {
+    const auto leaf = std::filesystem::path(params.path).filename().string();
+    if (is_hex_id(leaf)) {
+        return normalize_hex(leaf);
+    }
+    if (!params.info_hash.is_all_zeros()) {
+        return normalize_hex(lt::aux::to_hex(params.info_hash));
+    }
+    return {};
+}
