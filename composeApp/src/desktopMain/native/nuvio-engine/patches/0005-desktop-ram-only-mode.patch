+lt::storage_index_t RamStorageRegistry::register_torrent(
+    const lt::storage_params& params,
+    std::string canonical_id
+) {
+    std::lock_guard lock(mutex_);
+    auto storage = std::make_shared<TorrentStorage>(TorrentStorage{
+        std::move(canonical_id),
+        params.files,
+        {},
+    });
+    lt::storage_index_t idx{0};
+    if (!free_slots_.empty()) {
+        idx = free_slots_.back();
+        free_slots_.pop_back();
+        storages_[static_cast<std::size_t>(static_cast<std::uint32_t>(idx))] = storage;
+    } else {
+        idx = lt::storage_index_t(static_cast<std::uint32_t>(storages_.size()));
+        storages_.push_back(storage);
+    }
+    if (!storage->torrent_id.empty()) {
+        const auto existing = by_id_.find(storage->torrent_id);
+        if (existing != by_id_.end() && existing->second) {
+            for (const auto& [piece, data] : existing->second->pieces) {
+                static_cast<void>(piece);
+                if (data) {
+                    used_bytes_ -= std::min<std::uint64_t>(used_bytes_, data->size());
+                }
+                if (piece_count_ > 0) {
+                    --piece_count_;
+                }
+            }
+            existing->second->pieces.clear();
+        }
+        by_id_.insert_or_assign(storage->torrent_id, storage);
+    }
+    return idx;
+}
