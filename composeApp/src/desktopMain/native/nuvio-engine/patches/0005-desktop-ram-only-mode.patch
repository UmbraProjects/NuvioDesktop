+#include <libtorrent/io_context.hpp>
+#include <libtorrent/storage_defs.hpp>
+
+namespace nuvio::torrent {
+
+class RamStorageRegistry {
+public:
+    RamStorageRegistry() = default;
+
+    lt::storage_index_t register_torrent(
+        const lt::storage_params& params,
+        std::string canonical_id
+    );
+    void remove_torrent(lt::storage_index_t storage);
+    void remove_torrent_by_id(const std::string& torrent_id);
+
+    [[nodiscard]] std::shared_ptr<std::vector<char>> read_piece(
+        const std::string& torrent_id,
+        std::uint32_t piece
+    ) const;
+
+    [[nodiscard]] bool read_piece_slice(
+        const std::string& torrent_id,
+        std::uint32_t piece,
+        std::uint64_t offset_in_piece,
+        std::span<char> destination
+    ) const;
+
+    void erase_piece(const std::string& torrent_id, std::uint32_t piece);
+    void erase_pieces(
+        const std::string& torrent_id,
+        const std::vector<std::uint32_t>& pieces
+    );
+    void clear_all();
+
+    [[nodiscard]] std::uint64_t used_bytes() const;
+    [[nodiscard]] std::uint64_t piece_count() const;
+
+    void write_block(
+        lt::storage_index_t storage,
+        lt::piece_index_t piece,
+        int offset,
+        std::span<const char> data
+    );
+
+    [[nodiscard]] std::vector<char> read_block(
+        lt::storage_index_t storage,
+        const lt::peer_request& request,
+        lt::storage_error& error
+    ) const;
+
+    [[nodiscard]] lt::sha1_hash hash_piece(
+        lt::storage_index_t storage,
+        lt::piece_index_t piece,
+        lt::span<lt::sha256_hash> block_hashes,
+        lt::disk_job_flags_t flags,
+        lt::storage_error& error
+    ) const;
+
+    [[nodiscard]] lt::sha256_hash hash_block2(
+        lt::storage_index_t storage,
+        lt::piece_index_t piece,
+        int offset,
+        lt::storage_error& error
+    ) const;
+
+    void clear_piece_by_storage(lt::storage_index_t storage, lt::piece_index_t piece);
+    void clear_storage(lt::storage_index_t storage);
+
+private:
+    struct TorrentStorage {
+        std::string torrent_id;
+        lt::file_storage files;
+        std::unordered_map<std::uint32_t, std::shared_ptr<std::vector<char>>> pieces;
+
+        [[nodiscard]] int piece_size(lt::piece_index_t piece) const;
+    };
+
+    mutable std::mutex mutex_;
+    std::vector<std::shared_ptr<TorrentStorage>> storages_;
+    std::vector<lt::storage_index_t> free_slots_;
+    std::unordered_map<std::string, std::shared_ptr<TorrentStorage>> by_id_;
+    std::uint64_t used_bytes_ = 0;
+    std::uint64_t piece_count_ = 0;
+};
+
+[[nodiscard]] std::function<std::unique_ptr<lt::disk_interface>(
+    lt::io_context&,
+    const lt::settings_interface&,
+    lt::counters&
+)> make_ram_disk_io_constructor(std::shared_ptr<RamStorageRegistry> registry);
+
+}
