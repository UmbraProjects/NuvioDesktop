+void RamStorageRegistry::write_block(
+    const lt::storage_index_t storage,
+    const lt::piece_index_t piece,
+    const int offset,
+    const std::span<const char> data
+) {
+    if (offset < 0 || data.empty()) {
+        return;
+    }
+    std::lock_guard lock(mutex_);
+    const auto index = static_cast<std::size_t>(static_cast<std::uint32_t>(storage));
+    if (index >= storages_.size() || !storages_[index]) {
+        return;
+    }
+    auto& torrent = *storages_[index];
+    const auto piece_index = static_cast<std::uint32_t>(static_cast<int>(piece));
+    auto& piece_buffer = torrent.pieces[piece_index];
+    const auto expected_size = std::max(
+        torrent.piece_size(piece),
+        offset + static_cast<int>(data.size())
+    );
+    if (!piece_buffer) {
+        piece_buffer = std::make_shared<std::vector<char>>(
+            static_cast<std::size_t>(expected_size),
+            0
+        );
+        used_bytes_ += piece_buffer->size();
+        ++piece_count_;
+    } else if (static_cast<int>(piece_buffer->size()) < expected_size) {
+        const auto previous = piece_buffer->size();
+        auto resized = std::make_shared<std::vector<char>>(*piece_buffer);
+        resized->resize(static_cast<std::size_t>(expected_size), 0);
+        piece_buffer = std::move(resized);
+        used_bytes_ += piece_buffer->size() - previous;
+    }
+    std::memcpy(
+        piece_buffer->data() + static_cast<std::size_t>(offset),
+        data.data(),
+        data.size()
+    );
+}
+
+std::vector<char> RamStorageRegistry::read_block(
+    const lt::storage_index_t storage,
+    const lt::peer_request& request,
+    lt::storage_error& error
+) const {
+    std::lock_guard lock(mutex_);
+    const auto index = static_cast<std::size_t>(static_cast<std::uint32_t>(storage));
+    if (index >= storages_.size() || !storages_[index] || request.start < 0 ||
+        request.length <= 0) {
+        error.operation = lt::operation_t::file_read;
+        error.ec = boost::asio::error::eof;
+        return {};
+    }
+    const auto& torrent = *storages_[index];
+    const auto piece_index = static_cast<std::uint32_t>(static_cast<int>(request.piece));
+    const auto found = torrent.pieces.find(piece_index);
+    if (found == torrent.pieces.end() || !found->second ||
+        static_cast<int>(found->second->size()) <= request.start) {
+        error.operation = lt::operation_t::file_read;
+        error.ec = boost::asio::error::eof;
+        return {};
+    }
+    const auto available = std::min(
+        request.length,
+        static_cast<int>(found->second->size()) - request.start
+    );
+    return std::vector<char>(
+        found->second->begin() + request.start,
+        found->second->begin() + request.start + available
+    );
+}
+
+lt::sha1_hash RamStorageRegistry::hash_piece(
+    const lt::storage_index_t storage,
+    const lt::piece_index_t piece,
+    const lt::span<lt::sha256_hash> block_hashes,
+    const lt::disk_job_flags_t flags,
+    lt::storage_error& error
+) const {
+    std::shared_ptr<std::vector<char>> piece_data;
+    int piece_size2 = 0;
+    int blocks_in_piece2 = 0;
+    {
+        std::lock_guard lock(mutex_);
+        const auto index = static_cast<std::size_t>(static_cast<std::uint32_t>(storage));
+        if (index >= storages_.size() || !storages_[index]) {
+            error.operation = lt::operation_t::file_read;
+            error.ec = boost::asio::error::eof;
+            return {};
+        }
+        const auto& torrent = *storages_[index];
+        const auto piece_index = static_cast<std::uint32_t>(static_cast<int>(piece));
+        const auto found = torrent.pieces.find(piece_index);
+        if (found == torrent.pieces.end() || !found->second) {
+            error.operation = lt::operation_t::file_read;
+            error.ec = boost::asio::error::eof;
+            return {};
+        }
+        piece_data = found->second;
+        if (!block_hashes.empty()) {
+            piece_size2 = torrent.files.piece_size2(piece);
+            blocks_in_piece2 = torrent.files.blocks_in_piece2(piece);
+        }
+    }
+    if (!block_hashes.empty()) {
+        const char* buf = piece_data->data();
+        std::int64_t offset = 0;
+        const auto max_blocks = std::min<int>(
+            blocks_in_piece2,
+            static_cast<int>(block_hashes.size())
+        );
+        for (int k = 0; k < max_blocks; ++k) {
+            lt::hasher256 h2;
+            const auto remaining = std::min<std::int64_t>(
+                static_cast<std::int64_t>(piece_size2) - offset,
+                static_cast<std::int64_t>(piece_data->size()) - offset
+            );
+            if (remaining <= 0) {
+                break;
+            }
+            const auto len2 = static_cast<std::ptrdiff_t>(
+                std::min<std::int64_t>(lt::default_block_size, remaining)
+            );
+            h2.update({buf, len2});
+            buf += len2;
+            offset += len2;
+            block_hashes[k] = h2.final();
+        }
+    }
+    if (!(flags & lt::disk_interface::v1_hash) && !block_hashes.empty()) {
+        return {};
+    }
+    return lt::hasher(*piece_data).final();
+}
+
+lt::sha256_hash RamStorageRegistry::hash_block2(
+    const lt::storage_index_t storage,
+    const lt::piece_index_t piece,
+    const int offset,
+    lt::storage_error& error
+) const {
+    std::shared_ptr<std::vector<char>> piece_data;
+    int piece_size2 = 0;
+    {
+        std::lock_guard lock(mutex_);
+        const auto index = static_cast<std::size_t>(static_cast<std::uint32_t>(storage));
+        if (index >= storages_.size() || !storages_[index] || offset < 0) {
+            error.operation = lt::operation_t::file_read;
+            error.ec = boost::asio::error::eof;
+            return {};
+        }
+        const auto& torrent = *storages_[index];
+        const auto piece_index = static_cast<std::uint32_t>(static_cast<int>(piece));
+        const auto found = torrent.pieces.find(piece_index);
+        if (found == torrent.pieces.end() || !found->second ||
+            offset >= static_cast<int>(found->second->size())) {
+            error.operation = lt::operation_t::file_read;
+            error.ec = boost::asio::error::eof;
+            return {};
+        }
+        piece_data = found->second;
+        piece_size2 = torrent.files.piece_size2(piece);
+    }
+    const auto available = std::min(
+        piece_size2 - offset,
+        static_cast<int>(piece_data->size()) - offset
+    );
+    if (available <= 0) {
+        error.operation = lt::operation_t::file_read;
+        error.ec = boost::asio::error::eof;
+        return {};
+    }
+    const auto len = static_cast<std::ptrdiff_t>(std::min(lt::default_block_size, available));
+    return lt::hasher256(lt::span<const char>(piece_data->data() + offset, len)).final();
+}
+
+void RamStorageRegistry::clear_piece_by_storage(
+    const lt::storage_index_t storage,
+    const lt::piece_index_t piece
+) {
+    std::lock_guard lock(mutex_);
+    const auto index = static_cast<std::size_t>(static_cast<std::uint32_t>(storage));
+    if (index >= storages_.size() || !storages_[index]) {
+        return;
+    }
+    auto& pieces = storages_[index]->pieces;
+    const auto piece_it = pieces.find(static_cast<std::uint32_t>(static_cast<int>(piece)));
+    if (piece_it == pieces.end()) {
+        return;
+    }
+    if (piece_it->second) {
+        used_bytes_ -= std::min<std::uint64_t>(used_bytes_, piece_it->second->size());
+    }
+    if (piece_count_ > 0) {
+        --piece_count_;
+    }
+    pieces.erase(piece_it);
+}
+
+void RamStorageRegistry::clear_storage(const lt::storage_index_t storage) {
+    std::lock_guard lock(mutex_);
+    const auto index = static_cast<std::size_t>(static_cast<std::uint32_t>(storage));
+    if (index >= storages_.size() || !storages_[index]) {
+        return;
+    }
+    for (const auto& [piece, data] : storages_[index]->pieces) {
+        static_cast<void>(piece);
+        if (data) {
+            used_bytes_ -= std::min<std::uint64_t>(used_bytes_, data->size());
+        }
+        if (piece_count_ > 0) {
+            --piece_count_;
+        }
+    }
+    storages_[index]->pieces.clear();
+}
+
+std::function<std::unique_ptr<lt::disk_interface>(
+    lt::io_context&,
+    const lt::settings_interface&,
+    lt::counters&
+)> make_ram_disk_io_constructor(std::shared_ptr<RamStorageRegistry> registry) {
+    return [shared_registry = std::move(registry)](
+               lt::io_context& ioc,
+               const lt::settings_interface&,
+               lt::counters&
+           ) -> std::unique_ptr<lt::disk_interface> {
+        return std::make_unique<RamDiskIo>(ioc, shared_registry);
+    };
+}
+
+}
