+void RamStorageRegistry::remove_torrent(const lt::storage_index_t storage) {
+    std::lock_guard lock(mutex_);
+    const auto index = static_cast<std::size_t>(static_cast<std::uint32_t>(storage));
+    if (index >= storages_.size() || !storages_[index]) {
+        return;
+    }
+    auto entry = std::move(storages_[index]);
+    for (const auto& [piece, data] : entry->pieces) {
+        static_cast<void>(piece);
+        if (data) {
+            used_bytes_ -= std::min<std::uint64_t>(used_bytes_, data->size());
+        }
+        if (piece_count_ > 0) {
+            --piece_count_;
+        }
+    }
+    entry->pieces.clear();
+    if (!entry->torrent_id.empty()) {
+        const auto found = by_id_.find(entry->torrent_id);
+        if (found != by_id_.end() && found->second == entry) {
+            by_id_.erase(found);
+        }
+    }
+    free_slots_.push_back(storage);
+}
