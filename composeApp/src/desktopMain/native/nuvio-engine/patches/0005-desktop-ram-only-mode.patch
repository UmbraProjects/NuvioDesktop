+std::shared_ptr<std::vector<char>> RamStorageRegistry::read_piece(
+    const std::string& torrent_id,
+    const std::uint32_t piece
+) const {
+    std::lock_guard lock(mutex_);
+    const auto found = by_id_.find(torrent_id);
+    if (found == by_id_.end() || !found->second) {
+        return {};
+    }
+    const auto piece_it = found->second->pieces.find(piece);
+    if (piece_it == found->second->pieces.end()) {
+        return {};
+    }
+    return piece_it->second;
+}
+
+bool RamStorageRegistry::read_piece_slice(
+    const std::string& torrent_id,
+    const std::uint32_t piece,
+    const std::uint64_t offset_in_piece,
+    const std::span<char> destination
+) const {
+    if (destination.empty()) {
+        return true;
+    }
+    std::lock_guard lock(mutex_);
+    const auto found = by_id_.find(torrent_id);
+    if (found == by_id_.end() || !found->second) {
+        return false;
+    }
+    const auto piece_it = found->second->pieces.find(piece);
+    if (piece_it == found->second->pieces.end() || !piece_it->second) {
+        return false;
+    }
+    const auto& data = *piece_it->second;
+    if (offset_in_piece > data.size() ||
+        destination.size() > data.size() - static_cast<std::size_t>(offset_in_piece)) {
+        return false;
+    }
+    std::memcpy(
+        destination.data(),
+        data.data() + static_cast<std::size_t>(offset_in_piece),
+        destination.size()
+    );
+    return true;
+}
