+void RamStorageRegistry::erase_piece(
+    const std::string& torrent_id,
+    const std::uint32_t piece
+) {
+    std::lock_guard lock(mutex_);
+    const auto found = by_id_.find(torrent_id);
+    if (found == by_id_.end() || !found->second) {
+        return;
+    }
+    const auto piece_it = found->second->pieces.find(piece);
+    if (piece_it == found->second->pieces.end()) {
+        return;
+    }
+    if (piece_it->second) {
+        used_bytes_ -= std::min<std::uint64_t>(used_bytes_, piece_it->second->size());
+    }
+    if (piece_count_ > 0) {
+        --piece_count_;
+    }
+    found->second->pieces.erase(piece_it);
+}
+
+void RamStorageRegistry::erase_pieces(
+    const std::string& torrent_id,
+    const std::vector<std::uint32_t>& pieces
+) {
+    std::lock_guard lock(mutex_);
+    const auto found = by_id_.find(torrent_id);
+    if (found == by_id_.end() || !found->second) {
+        return;
+    }
+    for (const auto piece : pieces) {
+        const auto piece_it = found->second->pieces.find(piece);
+        if (piece_it == found->second->pieces.end()) {
+            continue;
+        }
+        if (piece_it->second) {
+            used_bytes_ -= std::min<std::uint64_t>(used_bytes_, piece_it->second->size());
+        }
+        if (piece_count_ > 0) {
+            --piece_count_;
+        }
+        found->second->pieces.erase(piece_it);
+    }
+}
