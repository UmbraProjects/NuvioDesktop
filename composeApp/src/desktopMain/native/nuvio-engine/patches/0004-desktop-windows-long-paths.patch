diff --git a/src/storage/windows_path.hpp b/src/storage/windows_path.hpp
new file mode 100644
index 0000000..c683c96
--- /dev/null
+++ b/src/storage/windows_path.hpp
@@ -0,0 +1,42 @@
+#ifndef NUVIO_ENGINE_WINDOWS_PATH_HPP
+#define NUVIO_ENGINE_WINDOWS_PATH_HPP
+
+#if defined(_WIN32)
+
+#include <filesystem>
+#include <string>
+
+namespace nuvio::storage {
+
+// Nuvio desktop: the extended-length ("\\?\") form of an absolute path, for Win32 file calls.
+// Payload paths are <cache>/payload/<info hash>/<the torrent's own folders and file name>, and
+// release names routinely take that past MAX_PATH (260): measured 299 characters for a UHD
+// remux under %LOCALAPPDATA%. Without the prefix CreateFileW reports such a file as missing
+// unless the host process is long-path aware (a manifest opt-in plus a machine-wide registry
+// switch, neither of which the engine controls). libtorrent already writes through this form.
+// MinGW's std::filesystem cannot use prefixed paths at all, so callers pair it with Win32 calls.
+// Relative paths are returned unchanged.
+inline std::wstring win32_path(const std::filesystem::path& path) {
+    if (path.native().starts_with(L"\\\\?\\")) {
+        return path.native();
+    }
+    auto native = path.lexically_normal().native();
+    for (auto& character : native) {
+        if (character == L'/') {
+            character = L'\\';
+        }
+    }
+    if (native.starts_with(L"\\\\")) {
+        return L"\\\\?\\UNC\\" + native.substr(2);
+    }
+    if (native.size() >= 3 && native[1] == L':' && native[2] == L'\\') {
+        return L"\\\\?\\" + native;
+    }
+    return native;
+}
+
+}
+
+#endif
+
+#endif
